# Hyperliquid Premium Bot — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git!

# ── Hyperliquid Live Trading (required for --mode live) ──
HYPERLIQUID_API_KEY=your_hyperliquid_key_here
HYPERLIQUID_API_SECRET=your_hyperliquid_secret_here

# ── Coinalyze (aggregated funding + OI from 15+ exchanges) ──
# Get free key at https://coinalyze.net/settings/api/
COINALYZE_API_KEY=your_coinalyze_key_here

# ── Binance (optional — used as fallback data source) ──
BINANCE_API_KEY=your_binance_key_here
BINANCE_API_SECRET=your_binance_secret_here

# ── Telegram notifications (optional) ──
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── Dashboard authentication (recommended) ──
# Enable token auth on the local dashboard (protects REST + Socket.IO).
# DASHBOARD_AUTH_ENABLED is read directly from the environment and is
# hash-neutral (does not change the Fase 10 config_hash).
DASHBOARD_AUTH_ENABLED=false
BOT_DASHBOARD_TOKEN=your_dashboard_token_here

# ── Dashboard per-IP rate limit (optional) ──
# Max REST requests per minute per client IP (default 100). Bounds
# brute-force attempts against the dashboard token. Hash-neutral.
DASHBOARD_RATE_LIMIT_PER_MIN=100
