[Unit]
Description=Hyperliquid verified monthly backup (research DB + live DB + L2)
# Stages a verified snapshot under BOT_BACKUP_ROOT (=/srv/hyperliquid/backups)
# which the operator PC then PULLS over Tailscale/SSH — the VPS local disk
# is staging, never the final destination.

[Service]
Type=oneshot
User=hyperliquid
Group=hyperliquid
WorkingDirectory=/srv/hyperliquid/app
EnvironmentFile=/etc/hyperliquid/bot.env

ExecStart=/srv/hyperliquid/app/.venv/bin/python -u -X utf8 scripts/ops/backup_research_data.py --tag monthly

# integrity_check on ~10 GB + gzip walks — allow headroom, stay polite.
MemoryMax=2500M
CPUWeight=40
IOWeight=40
TimeoutStartSec=7200

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/hyperliquid
ProtectHome=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hyperliquid-backup
