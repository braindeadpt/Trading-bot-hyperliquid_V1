# /etc/hyperliquid/bot.env — shared env for ALL hyperliquid containers.
#   sudo cp deploy/linux/bot.env.example /etc/hyperliquid/bot.env
#   sudoedit /etc/hyperliquid/bot.env   # fill real values
#   sudo chmod 600 /etc/hyperliquid/bot.env
# NEVER commit the filled file. This example is safe to commit.

# ── Paths (BOT_ prefix maps onto the YAML tree; keeps config_hash intact) ──
BOT_DATA_ROOT=/data
BOT_RESEARCH_DATABASE_PATH=/data/research/hyperliquid.db
# Operational DB stays at the yaml default data/live/bot.db (database.path is
# hashed — BOT_DATABASE_PATH would trip the Fase-10 frozen config_hash).
# compose.yaml binds /srv/hl/data/live onto /opt/hyperliquid/data/live so
# bot, jev-judge, watchdogs and backup-monthly share bot.db/jev_latest.json/bot.lock.
# L2 recording OFF on bots-01 — belt & suspenders: explicit flag AND empty path.
L2_BOOKS_ENABLED=false
BOT_MARKET_DATA_L2_RECORDING_PATH=
# Spec var from Adenda 1: 0 = do not retain L2 (Mac keeps 90d via yaml).
L2_BOOKS_RETENTION_DAYS=0
BOT_BACKUP_ROOT=/data/backups

# ── Disk guard (deploy/linux/disk_guard.sh) ──────────────────────────────
DISK_GUARD_FS=/data
# systemd EnvironmentFile does NOT strip trailing comments — keep them on
# their own lines or the values arrive as non-numeric strings.
# alert threshold (%)
DISK_WARN_PCT=80
# pause-collectors threshold (%) — creates $DISK_GUARD_FS/PAUSE_COLLECTORS
DISK_STOP_PCT=85
# DISK_GUARD_HC_URL=      # optional healthchecks.io ping URL (0600 file on host)

# ── SQLite WAL bound (bytes; unset = unchanged behaviour / Mac default) ──
BOT_SQLITE_JOURNAL_LIMIT_BYTES=67108864

# ── Reservoir (Hydromancer orderbook dataset; read-only S3, requester-pays) ──
AWS_PROFILE=reservoir
AWS_REGION=ap-northeast-1
RESERVOIR_BUCKET=hydromancer-reservoir
# ~/.aws is mounted read-only into the container; no keys here.

# ── Runtime ────────────────────────────────────────────────────────────
PYTHONIOENCODING=utf-8
PYTHONUTF8=1
MALLOC_ARENA_MAX=2

# ── Dashboard (container-internal :5000; host maps 127.0.0.1:8091) ───────
# Auth ON: tailscale serve exposes :8091 to the whole tailnet. Put a stable
# BOT_DASHBOARD_TOKEN in /srv/hl/secrets/bot-data.env (0600) — without it the
# bot generates an ephemeral token that is never logged (login impossible).
DASHBOARD_AUTH_ENABLED=true
# BOT_DASHBOARD_TOKEN=
# DASHBOARD_RATE_LIMIT_PER_MIN=100

# ── Secrets — fill on the host only. NEVER git/image/logs. ─────────────
# HYPERLIQUID_API_KEY=
# HYPERLIQUID_API_SECRET=
# COINALYZE_API_KEY=
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# CRYPTORANK_API_KEY=
