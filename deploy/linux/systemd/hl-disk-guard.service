[Unit]
Description=Hyperliquid disk guard (80% warn / 85% PAUSE_COLLECTORS)

[Service]
Type=oneshot
# bot.env carries the container path DISK_GUARD_FS=/data AND the thresholds
# (DISK_WARN_PCT/DISK_STOP_PCT) shared with the container guard — both guards
# toggle the same $FS/PAUSE_COLLECTORS, so thresholds must stay single-source.
# EnvironmentFile overrides Environment=, so the host path is pinned on the
# ExecStart env prefix instead (wins over the file). Hc URL falls back to
# /srv/hl/secrets/hc-hl-disk-guard.url.
EnvironmentFile=/etc/hyperliquid/bot.env
ExecStart=/usr/bin/env DISK_GUARD_FS=/srv/hl/data /usr/local/sbin/hl-disk-guard.sh
