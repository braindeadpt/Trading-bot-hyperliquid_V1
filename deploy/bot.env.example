# /etc/hyperliquid/bot.env — systemd EnvironmentFile for ALL hyperliquid-*
# units. Copy to /etc/hyperliquid/bot.env, fill in real values, then:
#   sudo chown hyperliquid:hyperliquid /etc/hyperliquid/bot.env
#   sudo chmod 600 /etc/hyperliquid/bot.env
# NEVER commit the filled file. This example is safe to commit.

# ── Paths (override the Windows values in config/settings.yaml) ──────────
# The BOT_ prefix maps onto the YAML tree (longest-prefix match):
#   BOT_RESEARCH_DATABASE_PATH -> research.database.path
#   BOT_DATABASE_PATH          -> database.path
#   BOT_MARKET_DATA_L2_RECORDING_PATH -> market_data.l2_recording.path
BOT_RESEARCH_DATABASE_PATH=/srv/hyperliquid/data/research/hyperliquid.db
BOT_DATABASE_PATH=/srv/hyperliquid/app/data/live/bot.db
BOT_MARKET_DATA_L2_RECORDING_PATH=/srv/hyperliquid/data/l2_books

# Verified-backup staging dir — the operator PC PULLS runs out of here over
# Tailscale/SSH (scripts/ops/pull_vps_backup.py). NOT a final destination.
BOT_BACKUP_ROOT=/srv/hyperliquid/backups

# ── Runtime ────────────────────────────────────────────────────────────
PYTHONIOENCODING=utf-8
PYTHONUTF8=1
# Prevents the SQLite mmap verify from exhausting page cache accounting on
# a 12 GB shared box (MemoryMax already bounds it, this keeps headroom).
MALLOC_ARENA_MAX=2

# ── Secrets — fill on the VPS only, via scp + chmod 600. NEVER git. ─────
# HYPERLIQUID_API_KEY=
# HYPERLIQUID_API_SECRET=
# COINALYZE_API_KEY=
# TYPESAFE_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=
# Vault passphrase, if the vault is used:
# VAULT_PASSWORD=
