# Logs (runtime only — never commit)
logs/

# SQLite runtime DB + runtime artifacts
data/live/
data/bot.lock
data/test_health.db
data/vault.enc

# Research artifacts (parity DBs, support packages, sweep outputs)
# Keep the frozen-window manifests tracked — CI and clones need them.
data/research/*
!data/research/phase10/
data/research/phase10/*
!data/research/phase10/phase10_preregister.json
!data/research/phase08_preregister.json
# Overnight research queue is the pre-registration artifact — it fixes the
# windows before results are seen; keep it under version control so history
# proves it was not edited after the fact. Session artifacts stay ignored.
!data/research/overnight_experiments/
data/research/overnight_experiments/*
!data/research/overnight_experiments/QUEUE.md
data/backtests/
data/backups/
# scratch config overrides for parity runs
data/tmp_*

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Temporary root-level dev/debug scripts
/test_*.py
/final_test.py
main.py.bak

# Virtual environments
venv/
env/
.venv/

# Environment variables (secrets)
.env

# IDE / local agent tooling
.vscode/
.idea/
.claude/*
# skill pointers to .agents/skills/ are committed; settings.local.json stays ignored
!.claude/skills/
# `npx skills` creates local junctions here — machine state, never committed
.claude/skills/executing-plans/
.claude/skills/systematic-debugging/
.claude/skills/test-driven-development/
.claude/skills/verification-before-completion/
.claude/skills/webapp-testing/
.claude/skills/writing-plans/
.claude/skills/writing-skills/
.freebuff/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build artifacts
build/
dist/
*.egg-info/

# Test / local artifacts
.pytest_cache/
htmlcov/
.coverage
test_output.log
test.log
test_results.txt
backtest_results.json

# Backtest data
tests/data/

# Ad-hoc local debug scripts (keep scripts/ops/backfill_candles.py etc. tracked)
scripts/_*
scripts/*/_*
scripts/**/check_candles.py
scripts/audit_*.py
scripts/diagnose_*.py
scripts/market_vs_*.py
