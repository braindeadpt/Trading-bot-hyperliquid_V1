# Hyperliquid Bot — environment overrides (copy to .env in project root)
# Never commit real secrets.

# Live signing (testnet/mainnet)
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_MAINNET_ENABLED=0

# Dashboard auth (alternative to config/settings.yaml dashboard.password)
# DASHBOARD_AUTH_ENABLED is a hash-neutral deployment switch (env-only):
# true/false overrides dashboard.auth_enabled without touching the Fase 10
# config_hash. BOT_DASHBOARD_TOKEN maps to dashboard.token (outside the hash).
DASHBOARD_AUTH_ENABLED=
BOT_DASHBOARD_TOKEN=
BOT_DASHBOARD_PASSWORD=

# Dashboard per-IP rate limit (optional, default 100 req/min per client IP)
# Bounds brute-force attempts against the dashboard token. Hash-neutral.
DASHBOARD_RATE_LIMIT_PER_MIN=

# Optional API keys
HYPERLIQUID_API_KEY=
HYPERLIQUID_API_SECRET=
COINALYZE_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# GoldRush HyperCore research backfill
GOLDRUSH_API_KEY=
